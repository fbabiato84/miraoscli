#!/usr/bin/env sh
# MiraOS launcher — runs the source build (packages/cli/dist/index.js).
# Build first: npm run build
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ ! -f "$ROOT/packages/cli/dist/index.js" ]; then
  echo "miraos: packages/cli/dist/index.js is missing." >&2
  echo "miraos: run 'npm run build' in $ROOT first." >&2
  exit 1
fi

exec "${NODE_BINARY:-node}" "$ROOT/packages/cli/dist/index.js" "$@"